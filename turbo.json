{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "envMode": "loose",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "typecheck": { "dependsOn": [], "outputs": [] },
    "test": { "outputs": [], "env": ["TZ"] },
    "test:int": { "cache": false },
    "dev": { "cache": false, "persistent": true }
  }
}
