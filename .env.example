# dotenv-linter:off UnorderedKey
# ─────────────────────────────────────────────────────────────────────────────
# Mundo Mascotix · Recetas veterinarias — variables de entorno
# Copia este fichero a .env para desarrollo local. En producción los secretos
# vienen de Key Vault mediante identidad gestionada (SPEC §10.1); la app NO
# arranca en producción si falta una variable obligatoria (validación zod).
# ─────────────────────────────────────────────────────────────────────────────

# Entorno de ejecución: development | test | production
NODE_ENV=development
# Puerto HTTP de la API (Fastify). Por defecto 3000.
PORT=3000
# Nivel de log de pino: fatal|error|warn|info|debug|trace. Por defecto info.
LOG_LEVEL=info

# ── Base de datos ───────────────────────────────────────────────────────────
# Cadena de conexión PostgreSQL. Obligatoria. (Local: docker-compose.)
DATABASE_URL=postgres://mmx:mmx@localhost:5432/mmx

# ── Blob Storage ────────────────────────────────────────────────────────────
# Solo local: cadena de conexión de Azurite.
BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://127.0.0.1:10000/devstoreaccount1;
# Azure: URL de la cuenta (acceso con identidad gestionada). Obligatoria en producción.
BLOB_ACCOUNT_URL=
# Key Vault (Azure). Obligatoria en producción.
# Autenticación de PostgreSQL: password (en DATABASE_URL) | entra (identidad gestionada; DATABASE_URL sin contraseña).
DATABASE_AUTH=password
KEY_VAULT_URL=
# Nombres de los secretos en Key Vault (por si el almacén es compartido y usa otros nombres).
KV_SECRETO_SIWEB_TOKEN=siweb-token
KV_SECRETO_CIFRADO=column-encryption-key
KV_SECRETO_SMTP=smtp-password

# ── CIMAVet (AEMPS) ─────────────────────────────────────────────────────────
# URL base de la API REST de CIMAVet.
CIMAVET_BASE_URL=https://cimavet.aemps.es/cimavet/rest/
# Peticiones por segundo máximas a CIMAVet. Por defecto 3.
CIMAVET_RPS=3
# Antigüedad máxima (horas) de la caché antes de verificar en vivo al dispensar. Por defecto 24.
CIMAVET_LIVE_CHECK_MAX_AGE_H=24
# Nomenclátor Veterinario (zip con PrescripcionVET.xml y los DICCIONARIO_*.xml). Enlace publicado en
# https://cimavet.aemps.es/cimavet/publico/nomenclator.html. Los XML no se versionan: se descargan con
# `pnpm nomenclator:fetch` (local/CI) o `pnpm worker nomenclator-import --descargar` (producción).
NOMENCLATOR_URL=https://listadomedicamentos.aemps.gob.es/prescripcionVET.zip

# ── Siweb360 ────────────────────────────────────────────────────────────────
# URL base de la API pública de Siweb360.
SIWEB_BASE_URL=https://app.siweb360.com/api/public/
# Token Bearer de Siweb360. SOLO local; en Azure se lee de Key Vault.
SIWEB_TOKEN=
# Política de escritura de stock: off | entries_only. Por defecto off.
# entries_only en prod SOLO tras pasar el spike de SPEC §12.3. Nunca se escriben salidas.
SIWEB_STOCK_WRITE_MODE=off
# Expresión regular que extrae el CN del SKU/nombre de la variante. Por defecto CN(\d{6,7})$
SIWEB_SKU_CN_REGEX=CN(\d{6,7})$
# Conciliación ticket ↔ dispensación: `tickets` lee GET tickets (solo tickets Pagado; sin lote) u `off`.
# TODO(decision D-02b): confirmar que la línea del ticket conserva el nombre del producto con el CN.
SIWEB_SALES_SOURCE=tickets
# Extrae el CN del nombre de la línea del ticket (grupo 1).
SIWEB_TICKET_CN_REGEX=CN\s?(\d{6,7})
# Alta/edición de productos por API (D-04b, pendiente). Por defecto false → tareas manuales.
SIWEB_CATALOG_WRITE=false
# Escritura de precios por API (no documentada). Por defecto false.
SIWEB_PRICE_WRITE=false
# Nombre del almacén de medicamentos en Siweb360 (D-12). Por defecto Farmacia.
SIWEB_WAREHOUSE_NAME=Farmacia
# Id del almacén fijado a mano (opcional; si vacío se resuelve por nombre al arrancar).
SIWEB_WAREHOUSE_ID=

# ── Extracción de recetas ───────────────────────────────────────────────────
# Proveedor: fake (fixtures, sin coste) | azure (modelo personalizado de Document Intelligence). Por defecto fake.
EXTRACTOR=fake
# Endpoint de Azure AI Document Intelligence (obligatorio con EXTRACTOR=azure).
DOCINTEL_ENDPOINT=
# Id del modelo personalizado de Document Intelligence entrenado con las recetas en Document Intelligence
# Studio (obligatorio con EXTRACTOR=azure). Mientras no esté entrenado, `prebuilt-layout` usa el modelo
# genérico con reglas por etiqueta (docs/extraccion-docintel.md).
DOCINTEL_MODEL_ID=
# Versión de la API REST de Document Intelligence. Por defecto 2024-11-30.
DOCINTEL_API_VERSION=2024-11-30
# ── Asistente de consultas ──────────────────────────────────────────────────
# off (sin asistente) | fake (guiones, demo y tests) | azure (despliegue de chat de Azure OpenAI / Foundry en la UE) | gemini (API de Gemini).
# Por defecto off.
ASSISTANT=off
# Endpoint del recurso (obligatorio con ASSISTANT=azure en producción), p. ej. https://<recurso>.openai.azure.com
ASSISTANT_ENDPOINT=
# Nombre del despliegue de chat (obligatorio con ASSISTANT=azure en producción). Admite herramientas y salida estructurada.
ASSISTANT_DEPLOYMENT=
# Con ASSISTANT=gemini: ASSISTANT_DEPLOYMENT es el modelo (p. ej. gemini-3.1-flash-lite) y el endpoint se deja vacío.
# Clave de la API de Gemini (solo local). En Azure se lee del secreto de Key Vault KV_SECRETO_ASISTENTE (gcp-gemini-api-key).
ASSISTANT_API_KEY=
# Versión de la API de chat. Por defecto 2024-10-21.
ASSISTANT_API_VERSION=2024-10-21
# Tiempo máximo por pregunta en milisegundos. Por defecto 20000.
ASSISTANT_TIMEOUT_MS=20000
# Límite mensual global de tokens (entrada + salida). Al 80 % avisa a administración; al 100 % pausa el asistente. Por defecto 3000000.
ASSISTANT_MONTHLY_TOKEN_LIMIT=3000000
# Precio por 1.000 tokens en euros de entrada y de salida (solo estimación de coste; opcional).
ASSISTANT_PRICE_IN_PER_1K_EUR=
ASSISTANT_PRICE_OUT_PER_1K_EUR=
# Solo desarrollo con DEV_BOOTSTRAP=1: `completo` carga el Nomenclátor entero (~20 s) para identificar
# medicamentos de recetas reales (lo usa `pnpm demo`); por defecto, la muestra de los tests.
DEV_NOMENCLATOR=muestra
# Umbral de confianza por debajo del cual un campo exige confirmación individual. Por defecto 0.85.
EXTRACTION_CONFIDENCE_THRESHOLD=0.85

# ── Reglas de negocio ───────────────────────────────────────────────────────
# Autorización de sustituciones: POST (por defecto, D-01) | PRE.
SUBSTITUTION_APPROVAL_MODE=POST
# Días máximos para que el garante firme una sustitución antes de alertar. Por defecto 7.
SUBSTITUTION_SIGN_MAX_DAYS=7
# Permitir dispensar otra presentación (cambio de formato/concentración, §4.3.1). Por defecto true.
ALLOW_PACK_SIZE_CHANGE=true
# Permitir dispensación parcial (D-10). Por defecto true.
ALLOW_PARTIAL_DISPENSATION=true
# Vida útil mínima (días) en recepción por debajo de la cual se avisa. Por defecto 90.
ENTRY_MIN_SHELF_LIFE_DAYS=90
# Carácter que el lector HID emite en lugar del separador GS (ASCII 29), p. ej. ~ o |. Vacío = ninguno.
SCANNER_GS_SUBSTITUTE=
# "Producto no válido" no forzable (D-05c, pendiente). Por defecto false.
PRODUCT_VALIDITY_HARD_BLOCK=false
# Permitir forzar defectos de forma en psicótropos. Por defecto false.
PSYCHOTROPIC_ALLOW_FORCE=false
# Fecha de corte operativo de entradas manuales en Siweb360 (D-03), formato AAAA-MM-DD. Opcional.
ENTRY_CUTOVER_DATE=

# ── Autenticación ───────────────────────────────────────────────────────────
# entra (Microsoft Entra ID) | dev (selector de usuario; IMPOSIBLE con NODE_ENV=production).
AUTH_MODE=dev
# Tenant y client id de la app registration de Entra (obligatorios con AUTH_MODE=entra).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
# Confiar en X-MS-CLIENT-PRINCIPAL de la autenticación integrada de Container Apps (solo con autenticación
# obligatoria en el ingress). Por defecto false.
AUTH_EASYAUTH=false

# ── Correo ──────────────────────────────────────────────────────────────────
# smtp | acs | console (escribe en log, sin datos personales). Por defecto console.
MAILER=console
# Destinatarios de los reportes semanales, separados por comas.
REPORT_RECIPIENTS=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Azure Communication Services Email (con MAILER=acs; acceso con identidad gestionada).
ACS_ENDPOINT=
ACS_SENDER=
# Teléfono de la farmacia que figura en el resguardo para el tutor.
FARMACIA_TELEFONO=

# ── Cifrado ─────────────────────────────────────────────────────────────────
# Clave AES-256-GCM (32 bytes en base64) para columnas personales. SOLO local; en Azure va en Key Vault.
COLUMN_ENCRYPTION_KEY=ZGV2LWtleS1ub3QtZm9yLXByb2R1Y3Rpb24tMzJiISE=

# ── Web ─────────────────────────────────────────────────────────────────────
# Directorio de la SPA compilada que sirve la API en producción. Opcional.
WEB_DIST_DIR=
# URL pública de la web (la que abre el móvil al leer el QR). Opcional: si falta se usa la del navegador
# y, en local, la IP de este equipo en la red (arranca la web con --host para que el móvil la alcance).
APP_PUBLIC_URL=
# Horas que dura el emparejamiento de un móvil con el PC. Por defecto 10 (un turno).
MOVIL_SESION_HORAS=10
