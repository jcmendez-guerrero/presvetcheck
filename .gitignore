docs/ref/*Arbol_Medicamentos_VET*.xlsx
# Worktrees de Claude Code (copias locales del repositorio por sesión).
.claude/worktrees/
# Parámetros reales del despliegue np (nombres internos, appId, correos): plantilla en main.bicepparam.example.
infra/np/main.bicepparam
